utor": null}, {"id": "sequence_diagrams_token_management_flow_jwt_middleware", "label": "JWT Middleware", "file_type": "concept", "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sequence_diagrams_token_management_flow_refresh_token_store", "label": "Refresh Token Store", "file_type": "concept", "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sequence_diagrams_token_management_flow_protected_api_routes", "label": "Protected API Routes", "file_type": "concept", "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sequence_diagrams_token_management_flow_revoked_token_handler", "label": "Revoked Token Handler", "file_type": "concept", "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sequence_diagrams_token_management_flow_token_rotation_option", "label": "Token Rotation Option", "file_type": "rationale", "rationale": "Rotation is documented as optional: issuing a fresh refresh token on every refresh shortens the window a stolen token is usable and makes replay detectable, but it costs an extra write to the token store and breaks clients that cache the old token, so the design leaves it as a toggle.", "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sequence_diagrams_token_management_flow_transparent_token_refresh", "label": "Transparent Token Refresh", "file_type": "rationale", "rationale": "Expiry is handled inside the HTTP interceptor, which swaps in a new access token and replays the original request, so protected screens never see a 401 and the user is not bounced to login for a routine expiry.", "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sequence_diagrams_token_management_flow_encryption_at_rest", "label": "Token Encryption at Rest", "file_type": "rationale", "rationale": "Both the on-device secure storage and the server-side refresh token store are annotated as encrypted at rest, so a stolen device image or a database dump alone does not yield usable credentials.", "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sequence_diagrams_token_management_flow_forced_reauth_edge_cases", "label": "Forced Re-Authentication Edge Cases", "file_type": "rationale", "rationale": "Device wipe/reinstall leaves no tokens and login from another device invalidates previous refresh tokens, so the flow deliberately treats a missing or superseded token as a clean forced re-login rather than an error state.", "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sequence_diagrams_token_management_flow_network_error_prompt", "label": "Network Error Retry Prompt", "file_type": "rationale", "rationale": "An offline or timed-out request is separated from an auth failure: the interceptor surfaces a retry/offline prompt instead of triggering a refresh or logout, so transient connectivity never costs the user their session.", "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "sequence_diagrams_token_management_flow_login_screen", "target": "sequence_diagrams_token_management_flow_auth_controller", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "weight": 1.0}, {"source": "sequence_diagrams_token_management_flow_auth_controller", "target": "sequence_diagrams_token_management_flow_refresh_token_store", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "weight": 1.0}, {"source": "sequence_diagrams_token_management_flow_login_screen", "target": "sequence_diagrams_token_management_flow_secure_storage", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "weight": 1.0}, {"source": "sequence_diagrams_token_management_flow_protected_app_screens", "target": "sequence_diagrams_token_management_flow_api_service_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "weight": 1.0}, {"source": "sequence_diagrams_token_management_flow_api_service_layer", "target": "sequence_diagrams_token_management_flow_http_interceptor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "weight": 1.0}, {"source": "sequence_diagrams_token_management_flow_http_interceptor", "target": "sequence_diagrams_token_management_flow_jwt_middleware", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "sequence_diagrams/token_management_flow.md", "source_location": null, "weight": 1.0}, {"source": "sequence_diagrams_token_management_flow_jwt_middleware", "target": "sequence_diagrams_token_management_flow_protected_api_routes", "relation