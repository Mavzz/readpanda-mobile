{"nodes": [{"id": "ios_readpanda_images_xcassets_splash_imageset_logo_splash_logo_1x", "label": "Splash Logo @1x (160px)", "file_type": "image", "source_file": "ios/ReadPanda/Images.xcassets/splash.imageset/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ios_readpanda_images_xcassets_splash_imageset_logo_splash_launch_mark", "label": "Rounded-Squircle Launch Mark", "file_type": "concept", "rationale": "The splash imageset is not a wordmark or a full-bleed illustration: it is the app icon artwork pre-baked with its own rounded-corner squircle mask and transparent surround, so the launch screen shows the icon shape the user just tapped. Keeping the mask inside the PNG (rather than applying a corner radius in the launch storyboard or a React Native splash component) makes the same asset render identically no matter which layer draws it, at the cost of duplicating the artwork alongside AppIcon.appiconset instead of referencing it.", "source_file": "ios/ReadPanda/Images.xcassets/splash.imageset/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ios_readpanda_images_xcassets_splash_imageset_logo_splash_logo_1x", "target": "ios_readpanda_images_xcassets_splash_imageset_logo_splash_launch_mark", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ios/ReadPanda/Images.xcassets/splash.imageset/logo.png", "source_location": null, "weight": 1.0}, {"source": "ios_readpanda_images_xcassets_splash_imageset_logo_splash_launch_mark", "target": "ios_readpanda_images_xcassets_appicon_appiconset_120_1_duplicate_slot_asset", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "ios/ReadPanda/Images.xcassets/splash.imageset/logo.png", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "splash_logo_scale_set", "label": "Uni