{"nodes": [{"id": "ios_readpanda_images_xcassets_appicon_appiconset_1024_appicon_marketing", "label": "App Icon 1024 (App Store Marketing)", "file_type": "image", "source_file": "ios/ReadPanda/Images.xcassets/AppIcon.appiconset/1024.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ios_readpanda_images_xcassets_appicon_appiconset_1024_brand_identity", "label": "Cozy Night Reading Brand Identity", "file_type": "concept", "rationale": "The master artwork is a panda reading an open book under a draped blanket, lit only by a small flashlight, against a near-black navy field with a warm amber pool of light. The composition encodes the product promise: private, immersive, after-dark reading. A dark-dominant palette was chosen over a light one so the icon reads as a night-reading companion and sits comfortably beside a dark reader UI; the single warm light source gives the mark a focal point that survives extreme downscaling to 40px, where only the glow and the silhouette remain legible.", "source_file": "ios/ReadPanda/Images.xcassets/AppIcon.appiconset/1024.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ios_readpanda_images_xcassets_appicon_appiconset_1024_appicon_marketing", "target": "ios_readpanda_images_xcassets_appicon_appiconset_1024_brand_identity", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ios/ReadPanda/Images.xcassets/AppIcon.appiconset/1024.png", "source_location": null, "weight": 1.0}, {"source": "ios_readpanda_images_xcassets_appicon_appiconset_1024_brand_identity", "target": "ios_readpanda_images_xcassets_splash_imageset_logo_splash_launch_mark", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "ios/ReadPanda/Images.xcassets/AppIcon.appiconset/1024.png", "source_location": null, "weight": 1.0}], "hype