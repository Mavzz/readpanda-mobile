# Template for the two backend environments. Copy it twice:
#
#   cp .env.example .env.dev    # a backend on your machine (leave BACKEND_URL empty)
#   cp .env.example .env.prod   # the deployed backend (set BACKEND_URL)
#
# then pick one with `yarn start:dev` or `yarn start:prod` (or `yarn env:dev`
# / `yarn env:prod` to switch without starting Metro). That copies the chosen
# file to .env, the file the app actually reads. Don't edit .env by hand; the
# next switch overwrites it. All three are gitignored.

# Local backend: the machine running it. localhost works for the iOS
# simulator; use your computer's LAN IP for a physical phone, and 10.0.2.2
# for the Android emulator.
Local_IP=localhost
API_VERSION=/api/v1

# Deployed backend: the Cloud Run service base URL (no trailing slash, no API
# version path; getBackendUrl() appends API_VERSION). Production is
#   BACKEND_URL=https://readpanda-backend-439290157125.asia-south1.run.app
# Leave empty to use Local_IP + port 3000. Must be https:// for TestFlight /
# App Store builds.
BACKEND_URL=

# RevenueCat public SDK keys (Project settings → API keys), one per store.
# Public by design, but kept here so dev and prod can point at different
# RevenueCat projects. Leave empty and ReadPanda+ purchases stay off.
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
