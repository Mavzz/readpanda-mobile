# Copy to fastlane/.env (git-ignored) and fill in. Relative paths are relative
# to the repo root. Keep the key files themselves outside the repo.

# App Store Connect API key (Users and Access → Integrations → Team Keys,
# role App Manager). Registers devices and updates profiles.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8

# Firebase service account JSON with the Firebase App Distribution Admin role
# (Project settings → Service accounts → Generate new private key).
FIREBASE_SERVICE_ACCOUNT=~/.config/readpanda/firebase-app-distribution.json

# Tester group aliases to send each release to, comma-separated.
FIREBASE_GROUPS=

# Sentry organization auth token (Settings → Developer Settings →
# Organization Tokens in readpanda-z9). The archive uploads the source maps
# and dSYMs with it so testers' stack traces are readable. Leave it empty and
# the build still works, with a warning.
SENTRY_AUTH_TOKEN=

# CI only (.github/workflows/firebase-release.yml writes these): one .p12
# holding the Apple Development and Apple Distribution certificates.
# CERT_P12_PATH=
# CERT_P12_PASSWORD=
